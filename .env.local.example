# Safe local-development example. Copy to .env only when using Docker Compose.
# Direct Make runs source a copied .env first, then use LOCAL_* fallbacks.
HTTP_ADDRESS=:8080
PARTNER_ID=local-partner
API_KEY=local-development-only-key
AUTH_MODE=disabled
TRANSACTION_TYPES=toll
DEFAULT_CURRENCY=USD

KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=transaction.review-candidates.v1
KAFKA_TLS=false
KAFKA_CA_FILE=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION=1
KAFKA_TOPIC_RETENTION=168h

STORE_DRIVER=memory
STORE_PATH=.local/data/transactions.ndjson
POSTGRES_URL=
DYNAMODB_ENDPOINT=
AWS_REGION=us-west-2
DYNAMODB_TABLE=transaction-intake

# Select at most one secret provider. Leave both empty for these local literals.
LOCAL_SECRET_FILE=
AWS_SECRET_ID=
