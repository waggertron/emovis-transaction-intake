# Production-shaped names only. Do not put real credentials in this file.
HTTP_ADDRESS=:8080
PARTNER_ID=
API_KEY=

KAFKA_BROKERS=broker-1.example.internal:9094,broker-2.example.internal:9094
KAFKA_TOPIC=transaction.review-candidates.v1
KAFKA_TLS=true
KAFKA_CA_FILE=/etc/ssl/certs/ca-certificates.crt
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION=3
KAFKA_TOPIC_RETENTION=168h

# Select exactly one shared production store: postgres or dynamodb.
STORE_DRIVER=dynamodb
STORE_PATH=
POSTGRES_URL=
DYNAMODB_ENDPOINT=
AWS_REGION=us-west-2
DYNAMODB_TABLE=transaction-intake-production

# Prefer this provider in AWS. Its JSON supplies API_KEY, PARTNER_ID, and Kafka SASL values.
LOCAL_SECRET_FILE=
AWS_SECRET_ID=arn:aws:secretsmanager:us-west-2:123456789012:secret:replace-me
